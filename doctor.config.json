{
  "$schema": "https://react.doctor/schema/config.json",
  "categories": {
    "Maintainability": "off"
  },
  "ignore": {
    "tags": ["react-native"],
    "files": [
      "**/*.config.js",
      "**/*.config.cjs",
      "**/*.config.mjs",
      "**/metro.config.js",
      "**/plugins/*.js",
      "**/components/ai-elements/**"
    ],
    "overrides": [
      {
        "files": ["**/lib/userLocalSettings/userLocalSettings.ts"],
        "rules": ["react-doctor/server-auth-actions"]
      },
      {
        "files": ["**/components/BookmarkHtmlHighlighter.tsx"],
        "rules": ["react-doctor/no-danger"]
      },
      {
        "files": ["**/components/dashboard/sidebar/AllLists.tsx"],
        "rules": ["react-doctor/rendering-conditional-render"]
      },
      {
        "files": ["**/components/dashboard/bookmarks/SummarizeBookmarkArea.tsx"],
        "rules": [
          "react-doctor/no-static-element-interactions",
          "react-doctor/click-events-have-key-events"
        ]
      }
    ]
  },
  "rules": {
    "react-doctor/rules-of-hooks": "off",
    "react-doctor/exhaustive-deps": "off",
    "react-doctor/no-event-handler": "off",
    "react-doctor/no-derived-state": "off",
    "react-doctor/no-derived-state-effect": "off",
    "react-doctor/no-chain-state-updates": "off",
    "react-doctor/no-pass-data-to-parent": "off",
    "react-doctor/no-pass-live-state-to-parent": "off",
    "react-doctor/no-cascading-set-state": "off",
    "react-doctor/no-initialize-state": "off",
    "react-doctor/no-reset-all-state-on-prop-change": "off",
    "react-doctor/no-prop-callback-in-effect": "off",
    "react-doctor/no-derived-useState": "off",
    "react-doctor/no-adjust-state-on-prop-change": "off",
    "react-doctor/prefer-useReducer": "off",
    "react-doctor/prefer-use-effect-event": "off",
    "react-doctor/query-no-query-in-effect": "off",
    "react-doctor/js-combine-iterations": "off",
    "react-doctor/js-flatmap-filter": "off",
    "react-doctor/js-index-maps": "off",
    "react-doctor/js-hoist-intl": "off",
    "react-doctor/async-parallel": "off",
    "react-doctor/async-await-in-loop": "off",
    "react-doctor/server-sequential-independent-await": "off",
    "react-doctor/rerender-state-only-in-handlers": "off",
    "react-doctor/rerender-lazy-state-init": "off",
    "react-doctor/rerender-lazy-ref-init": "off",
    "react-doctor/rerender-memo-with-default-value": "off",
    "react-doctor/rerender-memo-before-early-return": "off",
    "react-doctor/no-usememo-simple-expression": "off",
    "react-doctor/rendering-hydration-no-flicker": "off",
    "react-doctor/rendering-hydration-mismatch-time": "off",
    "react-doctor/no-dynamic-import-path": "off",
    "react-doctor/jsx-no-jsx-as-prop": "off",
    "react-doctor/jsx-no-constructed-context-values": "off",
    "react-doctor/no-array-index-key": "off",
    "react-doctor/no-array-index-as-key": "off",
    "react-doctor/nextjs-missing-metadata": "off",
    "react-doctor/nextjs-no-redirect-in-try-catch": "off",
    "react-doctor/nextjs-no-client-side-redirect": "off",
    "react-doctor/nextjs-no-use-search-params-without-suspense": "off",
    "react-doctor/nextjs-no-img-element": "off",
    "react-doctor/prefer-tag-over-role": "off",
    "react-doctor/heading-has-content": "off",
    "react-doctor/no-unknown-property": "off",
    "react-doctor/media-has-caption": "off",
    "react-doctor/no-inline-bounce-easing": "off",
    "react-doctor/no-layout-transition-inline": "off",
    "react-doctor/no-fetch-in-effect": "off",
    "react-doctor/iframe-missing-sandbox": "off",
    "react-doctor/label-has-associated-control": "off",
    "react-doctor/control-has-associated-label": "off",
    "react-doctor/expo-package-json-conflict": "off"
  }
}
